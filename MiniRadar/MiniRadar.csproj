<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.2.0</Version>
    <!-- Champs du manifeste affichés dans /xlplugins -->
    <Author>Powerl3ss</Author>
    <Name>MiniRadar</Name>
    <!-- Exigée par DalamudPackager, puis vidée par la GitHub Action pour n'afficher que la ligne des commandes. -->
    <Description>MiniRadar</Description>
    <Punchline>Les joueurs autour de toi sur la minimap : amis, compagnie et autres, chacun sa couleur.</Punchline>
    <RepoUrl>https://github.com/Powerl3ss/MiniRadar</RepoUrl>
    <Tags>minimap;radar;friends;fc;players</Tags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IconUrl>https://raw.githubusercontent.com/Powerl3ss/MiniRadar/main/MiniRadar/images/icon.png</IconUrl>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="images\icon.png" LogicalName="MiniRadar.icon.png" />
    <Content Include="images\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
